{
  "name": "timtro-mcp",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/timtro-mcp/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "vite build",
        "cwd": "{projectRoot}"
      }
    },
    "build:watch": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite build --watch",
        "cwd": "{projectRoot}"
      },
      "continuous": true
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.json",
        "cwd": "{projectRoot}"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node dist/server.mjs",
        "cwd": "{projectRoot}"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx apps/timtro-mcp/src/server.ts",
        "cwd": "{workspaceRoot}"
      }
    },
    "smoke": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node scripts/smoke-call.mjs",
        "cwd": "{workspaceRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run",
        "cwd": "{projectRoot}"
      }
    },
    "inspector": {
      "executor": "nx:run-commands",
      "dependsOn": ["build:watch"],
      "options": {
        "command": "mcp-inspector node {projectRoot}/dist/server.mjs",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
