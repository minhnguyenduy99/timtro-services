{
  "name": "timtro-mcp",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/timtro-mcp/src",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.json",
        "cwd": "{projectRoot}"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "vite build",
        "cwd": "{projectRoot}"
      }
    },
    "build:watch": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite build --watch",
        "cwd": "{projectRoot}"
      },
      "continuous": true
    },
    "dev:http": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec tsx scripts/dev-http-server.ts",
        "cwd": "{projectRoot}"
      }
    },
    "smoke": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/smoke-http.mjs",
        "cwd": "{workspaceRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run",
        "cwd": "{projectRoot}"
      }
    },
    "sam:validate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "sam validate --lint",
        "cwd": "{projectRoot}"
      }
    },
    "sam:local": {
      "executor": "nx:run-commands",
      "dependsOn": ["build:watch"],
      "options": {
        "command": "sam local start-api --env-vars env.local.json --port 3000",
        "cwd": "{projectRoot}"
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "dependsOn": ["test", "build"],
      "options": {
        "command": "sam deploy --config-env dev --parameter-overrides \"$(node scripts/format-sam-parameter-overrides.mjs env.dev.json)\"",
        "cwd": "{projectRoot}"
      }
    },
    "inspector:local": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec mcp-inspector --transport http --server-url http://localhost:3000/mcp",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
