{
  "name": "timtro-crawler",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/timtro-crawler/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "TIMTRO_CRAWLER_HANDLER=crawl vite build && TIMTRO_CRAWLER_HANDLER=sanitize vite build",
        "cwd": "{projectRoot}"
      }
    },
    "crawl:watch": {
      "executor": "nx:run-commands",
      "options": {
        "command": "TIMTRO_CRAWLER_HANDLER=crawl vite build --watch",
        "cwd": "{projectRoot}"
      },
      "continuous": true
    },
    "sanitize:watch": {
      "executor": "nx:run-commands",
      "options": {
        "command": "TIMTRO_CRAWLER_HANDLER=sanitize vite build --watch",
        "cwd": "{projectRoot}"
      },
      "continuous": true
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.json",
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run",
        "cwd": "{projectRoot}"
      }
    },
    "sam:validate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "sam validate --lint",
        "cwd": "{projectRoot}"
      }
    },
    "sam:local:crawl": {
      "executor": "nx:run-commands",
      "options": {
        "command": "sam local invoke CrawlFunction --template template.yaml --env-vars env.dev.json --parameter-overrides \"$(node scripts/format-sam-parameter-overrides.mjs env.dev.json)\" --region ap-southeast-1 --event events/crawl-schedule.json",
        "cwd": "{projectRoot}"
      }
    },
    "sam:local:sanitize": {
      "executor": "nx:run-commands",
      "options": {
        "command": "sam local invoke SanitizeFunction --template template.yaml --env-vars env.dev.json --parameter-overrides \"$(node scripts/format-sam-parameter-overrides.mjs env.dev.json)\" --region ap-southeast-1 --event events/sanitize-sqs.json",
        "cwd": "{projectRoot}"
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "dependsOn": ["test", "build"],
      "options": {
        "command": "sam deploy --template template.yaml --no-fail-on-empty-changeset",
        "cwd": "{projectRoot}"
      }
    }
  }
}
