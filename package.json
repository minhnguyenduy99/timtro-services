{
  "name": "timtro-mcp-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Nx workspace for the Timtro MCP server",
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "build": "nx build timtro-mcp",
    "start": "node apps/timtro-mcp/dist/server.mjs",
    "dev": "nx dev timtro-mcp",
    "inspector": "nx inspector timtro-mcp",
    "smoke": "nx smoke timtro-mcp",
    "test": "nx test timtro-mcp",
    "test:lib": "nx test rental-info",
    "crawler:deploy": "nx deploy timtro-crawler --config-env dev",
    "crawler:local": "nx sam:local:crawl timtro-crawler --outputStyle=dynamic-legacy",
    "crawler:migrate-rental-info-v2": "nx migrate:rental-info-v2 timtro-crawler"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "^0.21.2",
    "@types/node": "^25.8.0",
    "nx": "^22.7.2",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3"
  }
}
